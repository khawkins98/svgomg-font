{
  "name": "svgomg-font",
  "version": "0.2.0",
  "private": true,
  "description": "Drop in an SVG, embed its web fonts as base64 woff2, optionally optimize with SVGO. All client-side.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/launch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "svgo": "^4.0.0"
  }
}
